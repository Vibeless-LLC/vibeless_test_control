<Window x:Class="Gridline.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gridline.App"
        Title="Gridline - Untitled" Width="1280" Height="800">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="OnNew" />
        <CommandBinding Command="Open" Executed="OnOpen" />
        <CommandBinding Command="Save" Executed="OnSave" />
        <CommandBinding Command="SaveAs" Executed="OnSaveAs" />
        <CommandBinding Command="Undo" Executed="OnUndo" CanExecute="CanUndo" />
        <CommandBinding Command="Redo" Executed="OnRedo" CanExecute="CanRedo" />
        <CommandBinding Command="Copy" Executed="OnCopy" CanExecute="CanCopyPaste" />
        <CommandBinding Command="Paste" Executed="OnPaste" CanExecute="CanCopyPaste" />
        <CommandBinding Command="Close" Executed="OnExit" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="SaveAs" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top" MenuItem.SubmenuClosed="OnSubmenuClosed">
            <MenuItem Header="_File" AutomationProperties.AutomationId="MenuFile">
                <MenuItem Header="_New" Command="New" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open..." Command="Open" InputGestureText="Ctrl+O"
                          AutomationProperties.AutomationId="MenuOpen" />
                <MenuItem Header="_Save" Command="Save" InputGestureText="Ctrl+S"
                          AutomationProperties.AutomationId="MenuSave" />
                <MenuItem Header="Save _As..." Command="SaveAs" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Import CSV..." Click="OnImportCsv" AutomationProperties.AutomationId="MenuImportCsv" />
                <MenuItem Header="E_xport CSV..." Click="OnExportCsv" AutomationProperties.AutomationId="MenuExportCsv" />
                <Separator />
                <MenuItem Header="E_xit" Command="Close" />
            </MenuItem>
            <MenuItem Header="_Edit" AutomationProperties.AutomationId="MenuEdit">
                <MenuItem x:Name="MenuUndo" Header="_Undo" Click="OnUndoClick" InputGestureText="Ctrl+Z" IsEnabled="False"
                          AutomationProperties.AutomationId="MenuUndo" />
                <MenuItem x:Name="MenuRedo" Header="_Redo" Click="OnRedoClick" InputGestureText="Ctrl+Y" IsEnabled="False"
                          AutomationProperties.AutomationId="MenuRedo" />
                <Separator />
                <MenuItem Header="_Copy" Command="Copy" InputGestureText="Ctrl+C" />
                <MenuItem Header="_Paste" Command="Paste" InputGestureText="Ctrl+V" />
            </MenuItem>
        </Menu>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Grid.Column="0" Width="100"
                     AutomationProperties.AutomationId="NameBox"
                     PreviewKeyDown="OnNameBoxKeyDown" LostKeyboardFocus="OnNameBoxLostFocus" />
            <TextBox x:Name="FormulaBar" Grid.Column="1" MaxLength="32767"
                     AutomationProperties.AutomationId="FormulaBar"
                     PreviewKeyDown="OnFormulaBarKeyDown" LostKeyboardFocus="OnFormulaBarLostFocus" />
        </Grid>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="SelectionValue" AutomationProperties.AutomationId="SelectionValue" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="SelectionSum" AutomationProperties.AutomationId="SelectionSum" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="AutosaveStatus" AutomationProperties.AutomationId="AutosaveStatus" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="ClipboardStatus" AutomationProperties.AutomationId="ClipboardStatus" />
            </StatusBarItem>
        </StatusBar>
        <!-- Sheet tab strip (CR1.8): docked after the status bar, so it sits below the grid and above the status bar.
             Tabs (SheetTab_<index>) are rebuilt in code on SheetsChanged. -->
        <ScrollViewer x:Name="SheetTabsHost" DockPanel.Dock="Bottom" Background="#F3F3F3"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="SheetTabs"
                      MouseRightButtonUp="OnSheetTabsRightClick">
            <StackPanel x:Name="SheetTabsPanel" Orientation="Horizontal" Background="Transparent" MinHeight="24" />
        </ScrollViewer>
        <Grid x:Name="GridHost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:GridControl x:Name="Sheet" AutomationProperties.AutomationId="Grid" />
            <!-- In-cell editor overlay: offset by the header sizes (set from GridControl constants in code) and clipped to the cell area; a null
                 Canvas background lets clicks fall through to the grid. -->
            <Canvas x:Name="EditorLayer" ClipToBounds="True">
                <TextBox x:Name="CellEditor" Visibility="Collapsed" MaxLength="32767"
                         Padding="1,0" BorderThickness="2" BorderBrush="#217346"
                         FontFamily="Segoe UI" FontSize="12" VerticalContentAlignment="Center"
                         AutomationProperties.AutomationId="CellEditor"
                         PreviewKeyDown="OnEditorKeyDown" LostKeyboardFocus="OnEditorLostFocus"
                         TextChanged="OnEditorTextChanged" />
            </Canvas>
            <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical"
                       Minimum="1" Maximum="100000" SmallChange="1" Value="1" />
            <ScrollBar x:Name="HScroll" Grid.Row="1" Orientation="Horizontal"
                       Minimum="1" Maximum="702" SmallChange="1" Value="1" />
        </Grid>
    </DockPanel>
</Window>
